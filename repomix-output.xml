import { useEffect } from "react";
import { useNavigate } from "react-router-dom";
import logoUrl from "@/assets/neurogrip-logo.svg";

const AUTO_ADVANCE_MS = 3200;

export default function Welcome() {
  const navigate = useNavigate();

  useEffect(() => {
    if (!AUTO_ADVANCE_MS) return;
    const t = setTimeout(
      () => navigate("/dashboard", { replace: true }),
      AUTO_ADVANCE_MS,
    );
    return () => clearTimeout(t);
  }, [navigate]);

  return (
    <button
      type="button"
      onClick={() => navigate("/dashboard", { replace: true })}
      aria-label="Lanjut ke dashboard"
      className="flex-1 flex flex-col items-center justify-center gap-7 px-8
                 bg-gradient-to-b from-[#0F6E56] to-[#0A4A3A] text-center"
    >
      <p className="text-[19px] font-bold text-white">Rehabilitasi Bersama</p>

      <img src={logoUrl} alt="NeuroGrip" className="w-56" />

      <p className="text-[19px] font-bold text-white">Selamat Datang</p>
    </button>
  );
}
